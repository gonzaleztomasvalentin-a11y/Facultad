  { id: "M2", propertyId: "P2", issue: "Cambio de termotanque", cost: 210000, status: "Finalizado", responsible: "ServiGas SRL", date: "2026-06-02" },
  { id: "M3", propertyId: "P1", issue: "Pintura de pasillo", cost: 60000, status: "Pendiente", responsible: "Sin asignar", date: "2026-08-01" },
];

const revenueHistory = [
  { mes: "Feb", ingresos: 1150000, gastos: 90000 },
  { mes: "Mar", ingresos: 1195000, gastos: 60000 },
  { mes: "Abr", ingresos: 1195000, gastos: 145000 },
  { mes: "May", ingresos: 1195000, gastos: 40000 },
  { mes: "Jun", ingresos: 1195000, gastos: 210000 },
  { mes: "Jul", ingresos: 1195000, gastos: 145000 },
];

const uid = (p) => `${p}${Math.random().toString(36).slice(2, 7)}`;
const money = (n) => n.toLocaleString("es-AR", { style: "currency", currency: "ARS", maximumFractionDigits: 0 });

const statusColor = (t, status) => {
  const s = status.toLowerCase();
  if (["ocupada", "pagado", "finalizado", "activo"].includes(s)) return { bg: t.greenSoft, fg: t.green };
  if (["disponible", "pendiente"].includes(s)) return { bg: t.amberSoft, fg: t.amber };
  if (["mantenimiento", "atrasado", "en curso"].includes(s)) return { bg: t.redSoft, fg: t.red };
  return { bg: t.blueSoft, fg: t.blueSoftText };
};

/* ------------------------------------------------------------------ */
/*  SMALL UI PRIMITIVES                                                */
/* ------------------------------------------------------------------ */
function Badge({ t, status }) {
  const c = statusColor(t, status);
  return (
    <span
      className="px-2 py-1 rounded-full text-xs font-medium whitespace-nowrap"
      style={{ background: c.bg, color: c.fg, fontFamily: fontBody }}
    >
      {status}
    </span>
  );
}

function Card({ t, children, className = "", style = {} }) {
  return (
    <div
      className={`rounded-2xl ${className}`}
      style={{ background: t.surface, border: `1px solid ${t.border}`, boxShadow: t.shadow, ...style }}
    >
      {children}
    </div>
  );
}

function StatCard({ t, icon: Icon, label, value, trend, trendUp }) {
  return (
    <Card t={t} className="p-5 flex flex-col gap-3">
      <div className="flex items-center justify-between">
        <div
          className="w-9 h-9 rounded-xl flex items-center justify-center"
          style={{ background: t.blueSoft, color: t.blueSoftText }}
        >
          <Icon size={17} />
        </div>
        {trend && (
          <div
            className="flex items-center gap-1 text-xs font-medium"
            style={{ color: trendUp ? t.green : t.red, fontFamily: fontMono }}
          >
            {trendUp ? <ArrowUpRight size={14} /> : <ArrowDownRight size={14} />}
            {trend}
          </div>
        )}
      </div>
      <div>
        <div className="text-2xl font-semibold" style={{ color: t.text, fontFamily: fontDisplay }}>
          {value}
        </div>
        <div className="text-sm mt-0.5" style={{ color: t.textMuted, fontFamily: fontBody }}>
          {label}
        </div>
      </div>
    </Card>
  );
}

function IconBtn({ t, icon: Icon, onClick, danger }) {
  return (
    <button
      onClick={onClick}
      className="w-8 h-8 rounded-lg flex items-center justify-center transition-colors"
      style={{ color: danger ? t.red : t.textMuted, background: "transparent" }}
      onMouseEnter={(e) => (e.currentTarget.style.background = danger ? t.redSoft : t.surfaceAlt)}
      onMouseLeave={(e) => (e.currentTarget.style.background = "transparent")}
    >
      <Icon size={15} />
    </button>
  );
}

function PrimaryBtn({ t, children, onClick, icon: Icon }) {
  return (
    <button
      onClick={onClick}
      className="flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-sm font-medium transition-transform active:scale-95"
      style={{ background: t.blue, color: "#fff", fontFamily: fontBody }}
    >
      {Icon && <Icon size={15} />}
      {children}
    </button>
  );
}

function Input({ t, ...props }) {
  return (
    <input
      {...props}
      className={`w-full px-3 py-2 rounded-lg text-sm outline-none ${props.className || ""}`}
      style={{
        background: t.surfaceAlt,
        border: `1px solid ${t.border}`,
        color: t.text,
        fontFamily: fontBody,
      }}
    />
  );
}

function Select({ t, value, onChange, options }) {
  return (
    <select
      value={value}
      onChange={onChange}
      className="w-full px-3 py-2 rounded-lg text-sm outline-none"
      style={{ background: t.surfaceAlt, border: `1px solid ${t.border}`, color: t.text, fontFamily: fontBody }}
    >
      {options.map((o) => (
        <option key={o} value={o}>{o}</option>
      ))}
    </select>
  );
}

function Modal({ t, title, onClose, children }) {
  return (
    <div
      className="fixed inset-0 z-50 flex items-center justify-center p-4"
      style={{ background: "rgba(10,12,16,0.45)" }}
      onClick={onClose}
    >
      <div
        onClick={(e) => e.stopPropagation()}
        className="w-full max-w-md rounded-2xl p-5 max-h-[85vh] overflow-y-auto"
        style={{ background: t.surface, border: `1px solid ${t.border}` }}
      >
        <div className="flex items-center justify-between mb-4">
          <h3 className="text-base font-semibold" style={{ color: t.text, fontFamily: fontDisplay }}>{title}</h3>
          <IconBtn t={t} icon={X} onClick={onClose} />
        </div>
        {children}
      </div>
    </div>
  );
}

function Field({ t, label, children }) {
  return (
    <div className="mb-3">
      <label className="text-xs font-medium block mb-1" style={{ color: t.textMuted, fontFamily: fontBody }}>{label}</label>
      {children}
    </div>
  );
}

/* ------------------------------------------------------------------ */
/*  MAIN APP                                                           */
/* ------------------------------------------------------------------ */
export default function RentAI() {
  const [dark, setDark] = useState(false);
  const t = dark ? palette.dark : palette.light;
  const [view, setView] = useState("dashboard");
  const [navOpen, setNavOpen] = useState(false);
  const [search, setSearch] = useState("");

  const [properties, setProperties] = useState(initialProperties);
  const [tenants, setTenants] = useState(initialTenants);
  const [contracts, setContracts] = useState(initialContracts);
  const [payments, setPayments] = useState(initialPayments);
  const [maintenance, setMaintenance] = useState(initialMaintenance);

  const propName = (id) => properties.find((p) => p.id === id)?.address || "—";
  const tenantName = (id) => tenants.find((x) => x.id === id)?.name || "—";
  const contractOf = (id) => contracts.find((c) => c.id === id);

  const occupied = properties.filter((p) => p.status === "Ocupada").length;
  const available = properties.filter((p) => p.status === "Disponible").length;
  const monthlyIncome = contracts.reduce((s, c) => s + c.monthlyPrice, 0);
  const pending = payments.filter((p) => p.status !== "Pagado").length;
  const upcomingExpiring = contracts.filter((c) => {
    const days = (new Date(c.endDate) - new Date("2026-07-29")) / 86400000;
    return days >= 0 && days <= 90;
  });
  const maintCostMonth = maintenance.reduce((s, m) => s + m.cost, 0);

  const occupancyData = [
    { name: "Ocupada", value: occupied, color: t.green },
    { name: "Disponible", value: available, color: t.amber },
    { name: "Mantenimiento", value: properties.filter((p) => p.status === "Mantenimiento").length, color: t.red },
  ];

  const navItems = [
    { id: "dashboard", label: "Dashboard", icon: LayoutDashboard },
    { id: "properties", label: "Propiedades", icon: Building2 },
    { id: "tenants", label: "Inquilinos", icon: Users },
    { id: "contracts", label: "Contratos", icon: FileText },
    { id: "payments", label: "Pagos", icon: CreditCard },
    { id: "maintenance", label: "Mantenimiento", icon: Wrench },
    { id: "assistant", label: "Asistente IA", icon: MessageSquare },
  ];

  return (
    <div style={{ fontFamily: fontBody, background: t.bg, minHeight: "100vh", color: t.text }}>
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');
        * { box-sizing: border-box; }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-thumb { background: ${t.border}; border-radius: 8px; }
        table { border-collapse: collapse; width: 100%; }
      `}</style>

      <div className="flex min-h-screen">
        {/* SIDEBAR */}
        <aside
          className={`fixed md:static z-40 top-0 left-0 h-full md:h-auto w-64 flex-shrink-0 transition-transform duration-200 ${navOpen ? "translate-x-0" : "-translate-x-full md:translate-x-0"}`}
          style={{ background: t.surface, borderRight: `1px solid ${t.border}` }}
        >
          <div className="p-5 flex items-center gap-2">
            <div className="w-8 h-8 rounded-lg flex items-center justify-center" style={{ background: t.blue }}>
              <Sparkles size={16} color="#fff" />
            </div>
            <span className="text-lg font-semibold" style={{ fontFamily: fontDisplay, color: t.text }}>RentAI</span>
          </div>
          <nav className="px-3 flex flex-col gap-0.5">
            {navItems.map((it) => {
              const active = view === it.id;
              return (
                <button
                  key={it.id}
                  onClick={() => { setView(it.id); setNavOpen(false); }}
                  className="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-medium text-left transition-colors"
                  style={{
                    background: active ? t.blueSoft : "transparent",
                    color: active ? t.blueSoftText : t.textMuted,
                  }}
                >
                  <it.icon size={16} />
                  {it.label}
                </button>
              );
            })}
          </nav>
          <div className="absolute bottom-4 left-3 right-3">
            <button
              onClick={() => setDark(!dark)}
              className="w-full flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-medium"
              style={{ background: t.surfaceAlt, color: t.textMuted }}
            >
              {dark ? <Sun size={16} /> : <Moon size={16} />}
              {dark ? "Modo claro" : "Modo oscuro"}
            </button>
          </div>
        </aside>

        {navOpen && (
          <div className="fixed inset-0 z-30 md:hidden" style={{ background: "rgba(0,0,0,0.4)" }} onClick={() => setNavOpen(false)} />
        )}

        {/* MAIN */}
        <main className="flex-1 min-w-0">
          <header
            className="sticky top-0 z-20 flex items-center gap-3 px-4 md:px-8 py-4"
            style={{ background: t.bg + "F2", backdropFilter: "blur(6px)", borderBottom: `1px solid ${t.border}` }}
          >
            <button className="md:hidden" onClick={() => setNavOpen(true)} style={{ color: t.text }}>
              <Menu size={20} />
            </button>
            <div className="flex-1 relative max-w-sm">
              <Search size={15} style={{ position: "absolute", left: 10, top: 10, color: t.textFaint }} />
              <Input t={t} placeholder="Buscar propiedad, inquilino..." value={search} onChange={(e) => setSearch(e.target.value)} className="pl-8" />
            </div>
            <div className="hidden sm:block text-sm" style={{ color: t.textMuted, fontFamily: fontMono }}>29 jul 2026</div>
          </header>

          <div className="p-4 md:p-8">
            {view === "dashboard" && (
              <Dashboard t={t} {...{ properties, contracts, payments, maintenance, occupied, available, monthlyIncome, pending, upcomingExpiring, maintCostMonth, occupancyData, propName, tenantName }} />
            )}
            {view === "properties" && <Properties t={t} properties={properties} setProperties={setProperties} search={search} />}
            {view === "tenants" && <Tenants t={t} tenants={tenants} setTenants={setTenants} properties={properties} search={search} />}
            {view === "contracts" && <Contracts t={t} contracts={contracts} setContracts={setContracts} properties={properties} tenants={tenants} propName={propName} tenantName={tenantName} />}
            {view === "payments" && <Payments t={t} payments={payments} setPayments={setPayments} contracts={contracts} propName={propName} tenantName={tenantName} />}
            {view === "maintenance" && <Maintenance t={t} maintenance={maintenance} setMaintenance={setMaintenance} properties={properties} propName={propName} />}
            {view === "assistant" && (
              <Assistant t={t} dataset={{ properties, tenants, contracts, payments, maintenance }} />
            )}
          </div>
        </main>
      </div>
    </div>
  );
}

/* ------------------------------------------------------------------ */
/*  DASHBOARD                                                          */
/* ------------------------------------------------------------------ */
function Dashboard({ t, properties, contracts, payments, maintenance, occupied, available, monthlyIncome, pending, upcomingExpiring, maintCostMonth, occupancyData, propName, tenantName }) {
  return (
    <div className="flex flex-col gap-6">
      <div>
        <h1 className="text-2xl font-semibold" style={{ fontFamily: fontDisplay }}>Dashboard</h1>
        <p className="text-sm mt-1" style={{ color: t.textMuted }}>Resumen general de tu cartera de alquileres.</p>
      </div>

      <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <StatCard t={t} icon={Building2} label="Propiedades" value={properties.length} />
        <StatCard t={t} icon={Check} label="Ocupadas" value={occupied} trend={`${Math.round((occupied / properties.length) * 100)}%`} trendUp />
        <StatCard t={t} icon={DollarSign} label="Ingresos mensuales" value={money(monthlyIncome)} trend="+4.2%" trendUp />
        <StatCard t={t} icon={AlertTriangle} label="Pagos pendientes" value={pending} trend={pending > 1 ? "atención" : "ok"} trendUp={pending <= 1} />
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <Card t={t} className="p-5 lg:col-span-2">
          <div className="flex items-center justify-between mb-4">
            <h3 className="text-sm font-semibold" style={{ fontFamily: fontDisplay }}>Ingresos vs. gastos</h3>
            <TrendingUp size={16} style={{ color: t.textFaint }} />
          </div>
          <ResponsiveContainer width="100%" height={220}>
            <AreaChart data={revenueHistory}>
              <defs>
                <linearGradient id="ing" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stopColor={t.blue} stopOpacity={0.35} />
                  <stop offset="100%" stopColor={t.blue} stopOpacity={0} />
                </linearGradient>
                <linearGradient id="gas" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stopColor={t.red} stopOpacity={0.3} />
                  <stop offset="100%" stopColor={t.red} stopOpacity={0} />
                </linearGradient>
              </defs>
              <CartesianGrid strokeDasharray="3 3" stroke={t.border} vertical={false} />
              <XAxis dataKey="mes" tick={{ fontSize: 12, fill: t.textMuted }} axisLine={false} tickLine={false} />
              <YAxis tick={{ fontSize: 11, fill: t.textMuted }} axisLine={false} tickLine={false} tickFormatter={(v) => `${v / 1000}k`} width={40} />
              <Tooltip contentStyle={{ background: t.surface, border: `1px solid ${t.border}`, borderRadius: 10, fontSize: 12 }} formatter={(v) => money(v)} />
              <Area type="monotone" dataKey="ingresos" stroke={t.blue} fill="url(#ing)" strokeWidth={2} name="Ingresos" />
              <Area type="monotone" dataKey="gastos" stroke={t.red} fill="url(#gas)" strokeWidth={2} name="Gastos" />
            </AreaChart>
          </ResponsiveContainer>
        </Card>

        <Card t={t} className="p-5">
          <h3 className="text-sm font-semibold mb-4" style={{ fontFamily: fontDisplay }}>Ocupación</h3>
          <ResponsiveContainer width="100%" height={160}>
            <PieChart>
              <Pie data={occupancyData} dataKey="value" nameKey="name" innerRadius={45} outerRadius={65} paddingAngle={3}>
                {occupancyData.map((d, i) => <Cell key={i} fill={d.color} />)}
              </Pie>
              <Tooltip contentStyle={{ background: t.surface, border: `1px solid ${t.border}`, borderRadius: 10, fontSize: 12 }} />
            </PieChart>
          </ResponsiveContainer>
          <div className="flex flex-col gap-1.5 mt-2">
            {occupancyData.map((d) => (
              <div key={d.name} className="flex items-center justify-between text-xs">
                <span className="flex items-center gap-1.5" style={{ color: t.textMuted }}>
                  <span className="w-2 h-2 rounded-full" style={{ background: d.color }} />{d.name}
                </span>
                <span style={{ fontFamily: fontMono, color: t.text }}>{d.value}</span>
              </div>
            ))}
          </div>
        </Card>
      </div>

      {/* SIGNATURE ELEMENT: property portfolio grid ("plano de cartera") */}
      <Card t={t} className="p-5">
        <div className="flex items-center justify-between mb-4">
          <h3 className="text-sm font-semibold" style={{ fontFamily: fontDisplay }}>Plano de cartera</h3>
          <span className="text-xs" style={{ color: t.textFaint }}>cada celda = una propiedad</span>
        </div>
        <div className="grid gap-2" style={{ gridTemplateColumns: "repeat(auto-fill, minmax(120px, 1fr))" }}>
          {properties.map((p) => {
            const c = statusColor(t, p.status);
            return (
              <div key={p.id} className="rounded-xl p-3 flex flex-col gap-2" style={{ background: c.bg, minHeight: 84 }}>
                <div className="flex items-center gap-1 text-xs font-medium" style={{ color: c.fg }}>
                  <MapPin size={11} /> {p.type}
                </div>
                <div className="text-xs leading-snug" style={{ color: t.text }}>{p.address.split(",")[0]}</div>
                <div className="text-xs mt-auto font-medium" style={{ color: c.fg, fontFamily: fontMono }}>{p.status}</div>
              </div>
            );
          })}
        </div>
      </Card>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <Card t={t} className="p-5">
          <h3 className="text-sm font-semibold mb-3" style={{ fontFamily: fontDisplay }}>Contratos por vencer (90 días)</h3>
          <div className="flex flex-col gap-2">
            {upcomingExpiring.length === 0 && <p className="text-sm" style={{ color: t.textMuted }}>Sin vencimientos próximos.</p>}
            {upcomingExpiring.map((c) => (
              <div key={c.id} className="flex items-center justify-between text-sm py-2" style={{ borderTop: `1px solid ${t.border}` }}>
                <div>
                  <div style={{ color: t.text }}>{propName(c.propertyId)}</div>
                  <div className="text-xs" style={{ color: t.textMuted }}>{tenantName(c.tenantId)}</div>
                </div>
                <span className="text-xs font-medium" style={{ color: t.amber, fontFamily: fontMono }}>{c.endDate}</span>
              </div>
            ))}
          </div>
        </Card>

        <Card t={t} className="p-5">
          <h3 className="text-sm font-semibold mb-3" style={{ fontFamily: fontDisplay }}>Mantenimiento del mes</h3>
          <div className="flex items-center justify-between mb-2">
            <span className="text-sm" style={{ color: t.textMuted }}>Total gastado</span>
            <span className="text-sm font-semibold" style={{ fontFamily: fontMono }}>{money(maintCostMonth)}</span>
          </div>
          <div className="flex flex-col gap-2">
            {maintenance.map((m) => (
              <div key={m.id} className="flex items-center justify-between text-sm py-2" style={{ borderTop: `1px solid ${t.border}` }}>
                <div>
                  <div style={{ color: t.text }}>{m.issue}</div>
                  <div className="text-xs" style={{ color: t.textMuted }}>{propName(m.propertyId)}</div>
                </div>
                <Badge t={t} status={m.status} />
              </div>
            ))}
          </div>
        </Card>
      </div>
    </div>
  );
}

/* ------------------------------------------------------------------ */
/*  PROPERTIES                                                         */
/* ------------------------------------------------------------------ */
function Properties({ t, properties, setProperties, search }) {
  const [modal, setModal] = useState(null);
  const [form, setForm] = useState({ address: "", type: "Departamento", status: "Disponible", rent: "", notes: "" });

  const filtered = properties.filter((p) => p.address.toLowerCase().includes(search.toLowerCase()));

  const openNew = () => { setForm({ address: "", type: "Departamento", status: "Disponible", rent: "", notes: "" }); setModal("new"); };
  const openEdit = (p) => { setForm(p); setModal(p.id); };

  const save = () => {
    if (!form.address || !form.rent) return;
    if (modal === "new") {
      setProperties([...properties, { ...form, id: uid("P"), rent: Number(form.rent) }]);
    } else {
      setProperties(properties.map((p) => (p.id === modal ? { ...form, rent: Number(form.rent) } : p)));
    }
    setModal(null);
  };
  const remove = (id) => setProperties(properties.filter((p) => p.id !== id));

  return (
    <div className="flex flex-col gap-4">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl font-semibold" style={{ fontFamily: fontDisplay }}>Propiedades</h1>
          <p className="text-sm mt-1" style={{ color: t.textMuted }}>{properties.length} propiedades en tu cartera.</p>
        </div>
        <PrimaryBtn t={t} icon={Plus} onClick={openNew}>Agregar</PrimaryBtn>
      </div>

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {filtered.map((p) => (
          <Card key={p.id} t={t} className="p-4 flex flex-col gap-3">
            <div className="flex items-start justify-between">
              <Badge t={t} status={p.status} />
              <div className="flex gap-1">
                <IconBtn t={t} icon={Pencil} onClick={() => openEdit(p)} />
                <IconBtn t={t} icon={Trash2} danger onClick={() => remove(p.id)} />
              </div>
            </div>
            <div>
              <div className="text-sm font-medium" style={{ color: t.text }}>{p.address}</div>
              <div className="text-xs mt-0.5" style={{ color: t.textMuted }}>{p.type}</div>
            </div>
            <div className="flex items-center justify-between pt-2" style={{ borderTop: `1px solid ${t.border}` }}>
              <span className="text-xs" style={{ color: t.textMuted }}>Alquiler</span>
              <span className="text-sm font-semibold" style={{ fontFamily: fontMono }}>{money(p.rent)}</span>
            </div>
            {p.notes && <p className="text-xs" style={{ color: t.textFaint }}>{p.notes}</p>}
          </Card>
        ))}
      </div>

      {modal && (
        <Modal t={t} title={modal === "new" ? "Nueva propiedad" : "Editar propiedad"} onClose={() => setModal(null)}>
          <Field t={t} label="Dirección">
            <Input t={t} value={form.address} onChange={(e) => setForm({ ...form, address: e.target.value })} />
          </Field>
          <Field t={t} label="Tipo">
            <Select t={t} value={form.type} onChange={(e) => setForm({ ...form, type: e.target.value })} options={["Casa", "Departamento", "Local"]} />
          </Field>
          <Field t={t} label="Estado">
            <Select t={t} value={form.status} onChange={(e) => setForm({ ...form, status: e.target.value })} options={["Disponible", "Ocupada", "Mantenimiento"]} />
          </Field>
          <Field t={t} label="Valor del alquiler">
            <Input t={t} type="number" value={form.rent} onChange={(e) => setForm({ ...form, rent: e.target.value })} />
          </Field>
          <Field t={t} label="Observaciones">
            <Input t={t} value={form.notes} onChange={(e) => setForm({ ...form, notes: e.target.value })} />
          </Field>
          <PrimaryBtn t={t} onClick={save}>Guardar</PrimaryBtn>
        </Modal>
      )}
    </div>
  );
}

/* ------------------------------------------------------------------ */
/*  TENANTS                                                             */
/* ------------------------------------------------------------------ */
function Tenants({ t, tenants, setTenants, properties, search }) {
  const [modal, setModal] = useState(null);
  const [form, setForm] = useState({ name: "", dni: "", phone: "", email: "", startDate: "", propertyId: properties[0]?.id });

  const filtered = tenants.filter((x) => x.name.toLowerCase().includes(search.toLowerCase()));
  const openNew = () => { setForm({ name: "", dni: "", phone: "", email: "", startDate: "", propertyId: properties[0]?.id }); setModal("new"); };
  const openEdit = (x) => { setForm(x); setModal(x.id); };
  const save = () => {
    if (!form.name) return;
    if (modal === "new") setTenants([...tenants, { ...form, id: uid("T") }]);
    else setTenants(tenants.map((x) => (x.id === modal ? form : x)));
    setModal(null);
  };
  const remove = (id) => setTenants(tenants.filter((x) => x.id !== id));

  return (
    <div className="flex flex-col gap-4">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl font-semibold" style={{ fontFamily: fontDisplay }}>Inquilinos</h1>
          <p className="text-sm mt-1" style={{ color: t.textMuted }}>{tenants.length} inquilinos registrados.</p>
        </div>
        <PrimaryBtn t={t} icon={Plus} onClick={openNew}>Agregar</PrimaryBtn>
      </div>

      <Card t={t} className="overflow-x-auto">
        <table>
          <thead>
            <tr style={{ borderBottom: `1px solid ${t.border}` }}>
              {["Nombre", "DNI", "Teléfono", "Propiedad", "Ingreso", ""].map((h) => (
                <th key={h} className="text-left text-xs font-medium px-4 py-3" style={{ color: t.textMuted }}>{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {filtered.map((x) => (
              <tr key={x.id} style={{ borderBottom: `1px solid ${t.border}` }}>
                <td className="px-4 py-3 text-sm font-medium" style={{ color: t.text }}>{x.name}</td>
                <td className="px-4 py-3 text-sm" style={{ color: t.textMuted, fontFamily: fontMono }}>{x.dni}</td>
                <td className="px-4 py-3 text-sm" style={{ color: t.textMuted }}>{x.phone}</td>
                <td className="px-4 py-3 text-sm" style={{ color: t.textMuted }}>{properties.find((p) => p.id === x.propertyId)?.address.split(",")[0] || "—"}</td>
                <td className="px-4 py-3 text-sm" style={{ color: t.textMuted, fontFamily: fontMono }}>{x.startDate}</td>
                <td className="px-4 py-3">
                  <div className="flex gap-1 justify-end">
                    <IconBtn t={t} icon={Pencil} onClick={() => openEdit(x)} />
                    <IconBtn t={t} icon={Trash2} danger onClick={() => remove(x.id)} />
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </Card>

      {modal && (
        <Modal t={t} title={modal === "new" ? "Nuevo inquilino" : "Editar inquilino"} onClose={() => setModal(null)}>
          <Field t={t} label="Nombre"><Input t={t} value={form.name} onChange={(e) => setForm({ ...form, name: e.target.value })} /></Field>
          <Field t={t} label="DNI"><Input t={t} value={form.dni} onChange={(e) => setForm({ ...form, dni: e.target.value })} /></Field>
          <Field t={t} label="Teléfono"><Input t={t} value={form.phone} onChange={(e) => setForm({ ...form, phone: e.target.value })} /></Field>
          <Field t={t} label="Correo electrónico"><Input t={t} value={form.email} onChange={(e) => setForm({ ...form, email: e.target.value })} /></Field>
          <Field t={t} label="Fecha de ingreso"><Input t={t} type="date" value={form.startDate} onChange={(e) => setForm({ ...form, startDate: e.target.value })} /></Field>
          <Field t={t} label="Propiedad alquilada">
            <Select t={t} value={form.propertyId} onChange={(e) => setForm({ ...form, propertyId: e.target.value })} options={properties.map((p) => p.id)} />
          </Field>
          <PrimaryBtn t={t} onClick={save}>Guardar</PrimaryBtn>
        </Modal>
      )}
    </div>
  );
}

/* ------------------------------------------------------------------ */
/*  CONTRACTS                                                           */
/* ------------------------------------------------------------------ */
function Contracts({ t, contracts, setContracts, properties, tenants, propName, tenantName }) {
  const [modal, setModal] = useState(null);
  const blank = { propertyId: properties[0]?.id, tenantId: tenants[0]?.id, startDate: "", endDate: "", duration: "", monthlyPrice: "", deposit: "", adjustment: "Trimestral (IPC)" };
  const [form, setForm] = useState(blank);

  const openNew = () => { setForm(blank); setModal("new"); };
  const openEdit = (c) => { setForm(c); setModal(c.id); };
  const save = () => {
    if (!form.startDate || !form.endDate) return;
    const payload = { ...form, monthlyPrice: Number(form.monthlyPrice), deposit: Number(form.deposit) };
    if (modal === "new") setContracts([...contracts, { ...payload, id: uid("C") }]);
    else setContracts(contracts.map((c) => (c.id === modal ? payload : c)));
    setModal(null);
  };
  const remove = (id) => setContracts(contracts.filter((c) => c.id !== id));

  const daysLeft = (end) => Math.round((new Date(end) - new Date("2026-07-29")) / 86400000);

  return (
    <div className="flex flex-col gap-4">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl font-semibold" style={{ fontFamily: fontDisplay }}>Contratos</h1>
          <p className="text-sm mt-1" style={{ color: t.textMuted }}>{contracts.length} contratos vigentes.</p>
        </div>
        <PrimaryBtn t={t} icon={Plus} onClick={openNew}>Nuevo contrato</PrimaryBtn>
      </div>

      <div className="flex flex-col gap-3">
        {contracts.map((c) => {
          const left = daysLeft(c.endDate);
          return (
            <Card key={c.id} t={t} className="p-4 flex flex-col md:flex-row md:items-center gap-3 md:gap-6">
              <div className="flex-1 min-w-0">
                <div className="text-sm font-medium truncate" style={{ color: t.text }}>{propName(c.propertyId)}</div>
                <div className="text-xs mt-0.5" style={{ color: t.textMuted }}>{tenantName(c.tenantId)} · {c.duration}</div>
              </div>
              <div className="text-xs flex gap-4" style={{ color: t.textMuted, fontFamily: fontMono }}>
                <span>{c.startDate} → {c.endDate}</span>
              </div>
              <div className="text-sm font-semibold" style={{ fontFamily: fontMono }}>{money(c.monthlyPrice)}/mes</div>
              <Badge t={t} status={left < 0 ? "Vencido" : left <= 90 ? "Por vencer" : "Activo"} />
              <div className="flex gap-1">
                <IconBtn t={t} icon={Pencil} onClick={() => openEdit(c)} />
                <IconBtn t={t} icon={Trash2} danger onClick={() => remove(c.id)} />
              </div>
            </Card>
          );
        })}
      </div>

      {modal && (
        <Modal t={t} title={modal === "new" ? "Nuevo contrato" : "Editar contrato"} onClose={() => setModal(null)}>
          <Field t={t} label="Propiedad"><Select t={t} value={form.propertyId} onChange={(e) => setForm({ ...form, propertyId: e.target.value })} options={properties.map((p) => p.id)} /></Field>
          <Field t={t} label="Inquilino"><Select t={t} value={form.tenantId} onChange={(e) => setForm({ ...form, tenantId: e.target.value })} options={tenants.map((x) => x.id)} /></Field>
          <Field t={t} label="Fecha de inicio"><Input t={t} type="date" value={form.startDate} onChange={(e) => setForm({ ...form, startDate: e.target.value })} /></Field>
          <Field t={t} label="Fecha de vencimiento"><Input t={t} type="date" value={form.endDate} onChange={(e) => setForm({ ...form, endDate: e.target.value })} /></Field>
          <Field t={t} label="Duración"><Input t={t} value={form.duration} onChange={(e) => setForm({ ...form, duration: e.target.value })} placeholder="24 meses" /></Field>
          <Field t={t} label="Precio mensual"><Input t={t} type="number" value={form.monthlyPrice} onChange={(e) => setForm({ ...form, monthlyPrice: e.target.value })} /></Field>
          <Field t={t} label="Depósito"><Input t={t} type="number" value={form.deposit} onChange={(e) => setForm({ ...form, deposit: e.target.value })} /></Field>
          <Field t={t} label="Ajuste del alquiler"><Input t={t} value={form.adjustment} onChange={(e) => setForm({ ...form, adjustment: e.target.value })} /></Field>
          <PrimaryBtn t={t} onClick={save}>Guardar</PrimaryBtn>
        </Modal>
      )}
    </div>
  );
}

/* ------------------------------------------------------------------ */
/*  PAYMENTS                                                            */
/* ------------------------------------------------------------------ */
function Payments({ t, payments, setPayments, contracts, propName, tenantName }) {
  const [receipt, setReceipt] = useState(null);

  const markPaid = (id) => setPayments(payments.map((p) => (p.id === id ? { ...p, status: "Pagado" } : p)));

  const genReceipt = (p) => {
    const c = contracts.find((x) => x.id === p.contractId);
    setReceipt({
      propiedad: propName(c?.propertyId),
      inquilino: tenantName(c?.tenantId),
      mes: p.month,
      monto: p.amount,
      fecha: "29/07/2026",
      id: p.id,
    });
  };

  const downloadReceipt = () => {
    const text = `RECIBO DE PAGO\n\nN°: ${receipt.id}\nFecha de emisión: ${receipt.fecha}\nPropiedad: ${receipt.propiedad}\nInquilino: ${receipt.inquilino}\nPeríodo: ${receipt.mes}\nMonto: ${money(receipt.monto)}\n\nRentAI - Gestión de alquileres`;
    const blob = new Blob([text], { type: "text/plain" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = `recibo-${receipt.id}.txt`; a.click();
    URL.revokeObjectURL(url);
  };

  const totalPend = payments.filter((p) => p.status !== "Pagado").reduce((s, p) => s + p.amount, 0);

  return (
    <div className="flex flex-col gap-4">
      <div className="flex items-center justify-between flex-wrap gap-2">
        <div>
          <h1 className="text-2xl font-semibold" style={{ fontFamily: fontDisplay }}>Pagos</h1>
          <p className="text-sm mt-1" style={{ color: t.textMuted }}>Seguimiento de cobros e historial.</p>
        </div>
        <Card t={t} className="px-4 py-2 flex items-center gap-2">
          <span className="text-xs" style={{ color: t.textMuted }}>Total pendiente</span>
          <span className="text-sm font-semibold" style={{ fontFamily: fontMono, color: t.red }}>{money(totalPend)}</span>
        </Card>
      </div>

      <Card t={t} className="overflow-x-auto">
        <table>
          <thead>
            <tr style={{ borderBottom: `1px solid ${t.border}` }}>
              {["Propiedad", "Inquilino", "Período", "Monto", "Estado", ""].map((h) => (
                <th key={h} className="text-left text-xs font-medium px-4 py-3" style={{ color: t.textMuted }}>{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {payments.map((p) => {
              const c = contracts.find((x) => x.id === p.contractId);
              return (
                <tr key={p.id} style={{ borderBottom: `1px solid ${t.border}` }}>
                  <td className="px-4 py-3 text-sm" style={{ color: t.text }}>{propName(c?.propertyId)}</td>
                  <td className="px-4 py-3 text-sm" style={{ color: t.textMuted }}>{tenantName(c?.tenantId)}</td>
                  <td className="px-4 py-3 text-sm" style={{ color: t.textMuted, fontFamily: fontMono }}>{p.month}</td>
                  <td className="px-4 py-3 text-sm font-medium" style={{ fontFamily: fontMono }}>{money(p.amount)}</td>
                  <td className="px-4 py-3"><Badge t={t} status={p.status} /></td>
                  <td className="px-4 py-3">
                    <div className="flex gap-2 justify-end">
                      {p.status !== "Pagado" && (
                        <button onClick={() => markPaid(p.id)} className="text-xs font-medium px-2 py-1 rounded-lg" style={{ background: t.greenSoft, color: t.green }}>Marcar pagado</button>
                      )}
                      <button onClick={() => genReceipt(p)} className="text-xs font-medium px-2 py-1 rounded-lg flex items-center gap-1" style={{ background: t.blueSoft, color: t.blueSoftText }}>
                        <Download size={12} /> Recibo
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </Card>

      {receipt && (
        <Modal t={t} title="Recibo generado" onClose={() => setReceipt(null)}>
          <div className="text-sm flex flex-col gap-1.5 mb-4" style={{ color: t.text }}>
            <div className="flex justify-between"><span style={{ color: t.textMuted }}>Propiedad</span><span>{receipt.propiedad}</span></div>
            <div className="flex justify-between"><span style={{ color: t.textMuted }}>Inquilino</span><span>{receipt.inquilino}</span></div>
            <div className="flex justify-between"><span style={{ color: t.textMuted }}>Período</span><span>{receipt.mes}</span></div>
            <div className="flex justify-between"><span style={{ color: t.textMuted }}>Monto</span><span style={{ fontFamily: fontMono }}>{money(receipt.monto)}</span></div>
          </div>
          <PrimaryBtn t={t} icon={Download} onClick={downloadReceipt}>Descargar .txt</PrimaryBtn>
        </Modal>
      )}
    </div>
  );
}

/* ------------------------------------------------------------------ */
/*  MAINTENANCE                                                         */
/* ------------------------------------------------------------------ */
function Maintenance({ t, maintenance, setMaintenance, properties, propName }) {
  const [modal, setModal] = useState(null);
  const blank = { propertyId: properties[0]?.id, issue: "", cost: "", status: "Pendiente", responsible: "", date: "" };
  const [form, setForm] = useState(blank);

  const openNew = () => { setForm(blank); setModal("new"); };
  const openEdit = (m) => { setForm(m); setModal(m.id); };
  const save = () => {
    if (!form.issue) return;
    const payload = { ...form, cost: Number(form.cost) };
    if (modal === "new") setMaintenance([...maintenance, { ...payload, id: uid("M") }]);
    else setMaintenance(maintenance.map((m) => (m.id === modal ? payload : m)));
    setModal(null);
  };
  const remove = (id) => setMaintenance(maintenance.filter((m) => m.id !== id));

  return (
    <div className="flex flex-col gap-4">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl font-semibold" style={{ fontFamily: fontDisplay }}>Mantenimiento</h1>
          <p className="text-sm mt-1" style={{ color: t.textMuted }}>Reclamos y reparaciones en curso.</p>
        </div>
        <PrimaryBtn t={t} icon={Plus} onClick={openNew}>Nuevo reclamo</PrimaryBtn>
      </div>

      <div className="flex flex-col gap-3">
        {maintenance.map((m) => (
          <Card key={m.id} t={t} className="p-4 flex flex-col md:flex-row md:items-center gap-3 md:gap-6">
            <div className="flex-1 min-w-0">
              <div className="text-sm font-medium" style={{ color: t.text }}>{m.issue}</div>
              <div className="text-xs mt-0.5" style={{ color: t.textMuted }}>{propName(m.propertyId)} · {m.responsible}</div>
            </div>
            <div className="text-xs" style={{ color: t.textMuted, fontFamily: fontMono }}>{m.date}</div>
            <div className="text-sm font-semibold" style={{ fontFamily: fontMono }}>{money(m.cost)}</div>
            <Badge t={t} status={m.status} />
            <div className="flex gap-1">
              <IconBtn t={t} icon={Pencil} onClick={() => openEdit(m)} />
              <IconBtn t={t} icon={Trash2} danger onClick={() => remove(m.id)} />
            </div>
          </Card>
        ))}
      </div>

      {modal && (
        <Modal t={t} title={modal === "new" ? "Nuevo reclamo" : "Editar reclamo"} onClose={() => setModal(null)}>
          <Field t={t} label="Propiedad"><Select t={t} value={form.propertyId} onChange={(e) => setForm({ ...form, propertyId: e.target.value })} options={properties.map((p) => p.id)} /></Field>
          <Field t={t} label="Descripción"><Input t={t} value={form.issue} onChange={(e) => setForm({ ...form, issue: e.target.value })} /></Field>
          <Field t={t} label="Costo"><Input t={t} type="number" value={form.cost} onChange={(e) => setForm({ ...form, cost: e.target.value })} /></Field>
          <Field t={t} label="Estado"><Select t={t} value={form.status} onChange={(e) => setForm({ ...form, status: e.target.value })} options={["Pendiente", "En curso", "Finalizado"]} /></Field>
          <Field t={t} label="Responsable"><Input t={t} value={form.responsible} onChange={(e) => setForm({ ...form, responsible: e.target.value })} /></Field>
          <Field t={t} label="Fecha"><Input t={t} type="date" value={form.date} onChange={(e) => setForm({ ...form, date: e.target.value })} /></Field>
          <PrimaryBtn t={t} onClick={save}>Guardar</PrimaryBtn>
        </Modal>
      )}
    </div>
  );
}

/* ------------------------------------------------------------------ */
/*  AI ASSISTANT                                                        */
/* ------------------------------------------------------------------ */
function Assistant({ t, dataset }) {
  const [messages, setMessages] = useState([
    { role: "assistant", text: "Hola, soy el asistente de RentAI. Preguntame sobre vencimientos, pagos pendientes, rentabilidad o pedime un resumen del negocio." },
  ]);
  const [input, setInput] = useState("");
  const [loading, setLoading] = useState(false);
  const scrollRef = useRef(null);

  useEffect(() => { scrollRef.current?.scrollTo(0, scrollRef.current.scrollHeight); }, [messages]);

  const suggestions = [
    "¿Qué contratos vencen este mes?",
    "¿Qué inquilinos todavía no pagaron?",
    "¿Qué propiedad genera más ingresos?",
    "Genera un resumen financiero",
  ];

  const send = async (text) => {
    const q = text ?? input;
    if (!q.trim() || loading) return;
    setMessages((m) => [...m, { role: "user", text: q }]);
    setInput("");
    setLoading(true);
    try {
      const context = JSON.stringify(dataset);
      const res = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "claude-sonnet-4-6",
          max_tokens: 1000,
          system: `Sos el asistente de IA de RentAI, un sistema de gestión de alquileres. Respondé SIEMPRE en español rioplatense, de forma clara, breve y en lenguaje natural, como si hablaras con el dueño de las propiedades. Hoy es 29 de julio de 2026. Usá estos datos de la base (JSON) para responder con precisión, citando montos en pesos argentinos cuando corresponda:\n${context}`,
          messages: [{ role: "user", content: q }],
        }),
      });
      const data = await res.json();
      const textOut = (data.content || []).map((b) => b.text || "").filter(Boolean).join("\n") || "No pude generar una respuesta. Probá de nuevo.";
      setMessages((m) => [...m, { role: "assistant", text: textOut }]);
    } catch (e) {
      setMessages((m) => [...m, { role: "assistant", text: "Hubo un problema para conectar con la IA. Intentá nuevamente en un momento." }]);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="flex flex-col gap-4 h-[calc(100vh-140px)]">
      <div>
        <h1 className="text-2xl font-semibold" style={{ fontFamily: fontDisplay }}>Asistente IA</h1>
        <p className="text-sm mt-1" style={{ color: t.textMuted }}>Preguntá en lenguaje natural sobre tu negocio.</p>
      </div>

      <Card t={t} className="flex-1 flex flex-col overflow-hidden">
        <div ref={scrollRef} className="flex-1 overflow-y-auto p-5 flex flex-col gap-3">
          {messages.map((m, i) => (
            <div key={i} className={`flex ${m.role === "user" ? "justify-end" : "justify-start"}`}>
              <div
                className="max-w-[80%] px-4 py-2.5 rounded-2xl text-sm whitespace-pre-wrap"
                style={{
                  background: m.role === "user" ? t.blue : t.surfaceAlt,
                  color: m.role === "user" ? "#fff" : t.text,
                  fontFamily: fontBody,
                }}
              >
                {m.text}
              </div>
            </div>
          ))}
          {loading && (
            <div className="flex justify-start">
              <div className="px-4 py-2.5 rounded-2xl text-sm" style={{ background: t.surfaceAlt, color: t.textMuted }}>Pensando…</div>
            </div>
          )}
        </div>

        <div className="p-3 flex gap-2 flex-wrap" style={{ borderTop: `1px solid ${t.border}` }}>
          {suggestions.map((s) => (
            <button key={s} onClick={() => send(s)} className="text-xs px-2.5 py-1.5 rounded-full" style={{ background: t.blueSoft, color: t.blueSoftText }}>{s}</button>
          ))}
        </div>

        <div className="p-3 flex gap-2" style={{ borderTop: `1px solid ${t.border}` }}>
          <Input t={t} value={input} onChange={(e) => setInput(e.target.value)} onKeyDown={(e) => e.key === "Enter" && send()} placeholder="Escribí tu pregunta..." />
          <button onClick={() => send()} className="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style={{ background: t.blue, color: "#fff" }}>
            <Send size={16} />
          </button>
        </div>
      </Card>
    </div>
  );
}
