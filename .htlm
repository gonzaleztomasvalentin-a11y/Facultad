import React, { useState, useMemo, useRef, useEffect } from "react";
import {
  LayoutDashboard, Building2, Users, FileText, CreditCard, Wrench,
  MessageSquare, Sun, Moon, Search, Plus, X, Check, AlertTriangle,
  TrendingUp, Download, Trash2, Pencil, DollarSign, Calendar,
  Menu, Send, Sparkles, ArrowUpRight, ArrowDownRight, MapPin
} from "lucide-react";
import {
  AreaChart, Area, XAxis, YAxis, Tooltip, ResponsiveContainer,
  PieChart, Pie, Cell, CartesianGrid
} from "recharts";

