const initialContracts = [
  { id: "C1", propertyId: "P1", tenantId: "T1", startDate: "2024-03-01", endDate: "2026-03-01", duration: "24 meses", monthlyPrice: 380000, deposit: 380000, adjustment: "Trimestral (IPC)" },
  { id: "C2", propertyId: "P2", tenantId: "T2", startDate: "2023-11-15", endDate: "2026-08-15", duration: "36 meses", monthlyPrice: 520000, deposit: 520000, adjustment: "Semestral" },
  { id: "C3", propertyId: "P4", tenantId: "T3", startDate: "2025-01-10", endDate: "2026-09-10", duration: "24 meses", monthlyPrice: 295000, deposit: 295000, adjustment: "Trimestral (IPC)" },
