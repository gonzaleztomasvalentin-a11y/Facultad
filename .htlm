  light: {
    bg: "#F6F7F9",
    surface: "#FFFFFF",
    surfaceAlt: "#F0F2F5",
    border: "#E5E8EC",
    text: "#14171F",
    textMuted: "#6B7280",
    textFaint: "#9CA3AF",
    blue: "#2452E8",
    blueSoft: "#EDF1FE",
    blueSoftText: "#2452E8",
    green: "#0F9D58",
    greenSoft: "#E8F7EF",
    amber: "#B7791F",
    amberSoft: "#FDF3E1",
    red: "#D5493B",
    redSoft: "#FBEAE8",
    shadow: "0 1px 2px rgba(20,23,31,0.04), 0 1px 8px rgba(20,23,31,0.04)",
  },
  dark: {
    bg: "#0E1116",
    surface: "#161A21",
    surfaceAlt: "#1D222B",
    border: "#262C36",
    text: "#F1F3F6",
    textMuted: "#9AA3B2",
    textFaint: "#6B7480",
    blue: "#5A7CFF",
    blueSoft: "#1B2340",
    blueSoftText: "#8FA4FF",
    green: "#2FBE79",
    greenSoft: "#132A20",
    amber: "#E0A93F",
    amberSoft: "#332510",
    red: "#E2695C",
    redSoft: "#331B18",
    shadow: "0 1px 2px rgba(0,0,0,0.3), 0 1px 8px rgba(0,0,0,0.3)",
  },
};

const fontDisplay = "'Sora', 'Segoe UI', system-ui, sans-serif";
const fontBody = "'Inter', 'Segoe UI', system-ui, sans-serif";
const fontMono = "'JetBrains Mono', 'SFMono-Regular', Menlo, monospace";

